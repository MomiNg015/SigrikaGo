{
  "name": "sigrika-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch-path=server --watch-path=src/shared server/index.js",
    "build": "vite build",
    "check": "npm test && npm run build && node -e \"process.env.JWT_SECRET='12345678901234567890123456789012';process.env.PUBLIC_ORIGIN='https://sigrika.example';import('./scripts/check-production-config.mjs')\" && npm run docs:system-design",
    "start": "node server/index.js",
    "test": "vitest run --exclude \"**/.worktrees/**\" --exclude \"tests/e2e/**\" --exclude \"tests/stability/**\"",
    "test:e2e": "playwright test",
    "test:stability": "playwright test -c playwright.stability.config.js",
    "verify:stability": "node scripts/verify-stability.mjs",
    "export:skill-gifs": "node scripts/export-skill-gifs.mjs",
    "test:e2e:ui": "playwright test --ui",
    "docs:system-design": "node scripts/render-system-design-html.mjs",
    "docs:utf8": "node scripts/write-utf8-doc.mjs",
    "check:production": "node scripts/check-production-config.mjs",
    "backfill:user-assets": "node scripts/backfill-structured-user-assets.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "@prisma/client": "6.8.2",
    "@vitejs/plugin-react": "^4.4.1",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "multer": "^2.1.1",
    "pixi.js": "^8.19.0",
    "prisma": "6.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
