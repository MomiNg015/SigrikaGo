{
  "name": "sigrika-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "predev:server": "prisma generate",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch-path=server --watch-path=src/shared server/index.js",
    "build": "vite build",
    "check": "npm run lint && npm test && npm run build && node -e \"process.env.JWT_SECRET='12345678901234567890123456789012';process.env.PUBLIC_ORIGIN='https://sigrika.example';import('./scripts/check-production-config.mjs')\" && npm run docs:system-design",
    "lint": "eslint .",
    "prestart": "prisma generate",
    "start": "node server/index.js",
    "test": "vitest run --exclude \"**/.worktrees/**\" --exclude \"**/.codex-run/**\" --exclude \"tests/e2e/**\" --exclude \"tests/stability/**\"",
    "test:e2e": "node scripts/run-playwright-suite.mjs e2e",
    "test:stability": "node scripts/run-playwright-suite.mjs stability",
    "verify:battle-fixes": "node scripts/verify-battle-fixes.mjs",
    "verify:stability": "node scripts/verify-stability.mjs",
    "verify:capacity": "node scripts/verify-capacity.mjs",
    "export:skill-gifs": "node scripts/export-skill-gifs.mjs",
    "test:e2e:ui": "node scripts/run-playwright-suite.mjs e2e --ui",
    "docs:system-design": "node scripts/render-system-design-html.mjs",
    "docs:utf8": "node scripts/write-utf8-doc.mjs",
    "check:production": "node scripts/check-production-config.mjs",
    "admin:snapshot": "node scripts/export-admin-default-snapshot.mjs",
    "backfill:user-assets": "node scripts/backfill-structured-user-assets.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "@prisma/client": "6.8.2",
    "@vitejs/plugin-react": "^4.4.1",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "multer": "^2.1.1",
    "pixi.js": "^8.19.0",
    "prisma": "6.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "roughjs": "^4.6.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1"
  }
}
