{
  "西格莉卡-成功": [
    {
      "role": "旁白",
      "text": "午后的围棋部，西格莉卡聚精会神地翻着漫画。"
    },
    {
      "role": "玩家选项",
      "text": "把彩虹豆豆跳跳糖递给西格莉卡"
    },
    {
      "role": "西格莉卡",
      "text": "哇，好漂亮的糖！这些颜色像揉在一起的星光一样。"
    },
    {
      "role": "玩家选项",
      "text": "要尝一颗吗？"
    },
    {
      "role": "西格莉卡",
      "text": "嗯！闻起来甜甜的，那我就不客气啦。"
    },
    {
      "role": "旁白",
      "text": "西格莉卡把糖果放进口中，开心地嚼了几下。"
    },
    {
      "role": "西格莉卡",
      "text": "唔，味道还不错——嗝！"
    },
    {
      "role": "西格莉卡",
      "text": "诶？嗝！怎么回......嗝！为什么嗝不下来呀！"
    },
    {
      "role": "玩家选项",
      "text": "你还好吗？"
    },
    {
      "role": "西格莉卡",
      "text": "我、嗝没事！嗝！我先去找嗝医生看看！"
    },
    {
      "role": "旁白",
      "text": "西格莉卡红着脸跑远了。等你抬头想叫住她时，她早已不见踪影。"
    },
    {
      "role": "旁白",
      "text": "看来暂时不能找她下棋了。"
    }
  ],
  "达妮娅-成功": [
    {
      "role": "旁白",
      "text": "达妮娅靠在椅背上，似乎已经睡着了。"
    },
    {
      "role": "玩家选项",
      "text": "偷偷把彩虹豆豆跳跳糖塞进达妮娅嘴里"
    },
    {
      "role": "达妮娅",
      "text": "唔……咕咚。"
    },
    {
      "role": "旁白",
      "text": "达妮娅迷迷糊糊地咽下糖果。下一秒，她猛然睁开双眼——彩虹射线同时从她的双眼和嘴巴里喷射而出！"
    },
    {
      "role": "达妮娅",
      "text": "唔唔唔——？！"
    },
    {
      "role": "玩家选项",
      "text": "成功了！真的会喷彩虹诶！"
    },
    {
      "role": "达妮娅",
      "text": "所以你早就知道会变成这样？！"
    },
    {
      "role": "玩家选项",
      "text": "「别动别动，让我再看清楚一点！」"
    },
    {
      "role": "达妮娅",
      "text": "{username}——！！"
    },
    {
      "role": "旁白",
      "text": "达妮娅顶着三道乱晃的彩虹射线站了起来。在她爆发之前，还是赶紧溜了吧。"
    }
  ],
  "达妮娅-失败": [
    {
      "role": "旁白",
      "text": "达妮娅靠在椅背上，似乎已经睡着了。"
    },
    {
      "role": "玩家选项",
      "text": "偷偷把彩虹豆豆跳跳糖塞进达妮娅嘴里"
    },
    {
      "role": "达妮娅",
      "text": "……不要趁别人睡着的时候往别人嘴里塞奇怪的东西。"
    },
    {
      "role": "玩家选项",
      "text": "啊...原来你还醒着？"
    },
    {
      "role": "达妮娅",
      "text": "本来没有。可是包装袋都快贴到我脸上了……"
    },
    {
      "role": "达妮娅",
      "text": "而且看这颗糖的颜色，感觉如果吃下去的话会发生很麻烦的事情。"
    },
    {
      "role": "达妮娅",
      "text": "你自己留着吧……我要继续睡了。下次不许偷袭哦。"
    },
    {
      "role": "旁白",
      "text": "达妮娅趴在桌子上，把脸埋在了臂弯中。"
    }
  ],
  "爱弥斯-成功": [
    {
      "role": "旁白",
      "text": "午后的围棋部，爱弥斯坐在棋盘前，指尖转着一枚黑棋，认真研究棋盘上的一道死活题。"
    },
    {
      "role": "爱弥斯",
      "text": "这里扳一下，那边就会被打吃……唔，这本《鬼手魔手》死活题到底是哪位神仙出的？每道题的陷阱路线是不是有点太多了？"
    },
    {
      "role": "玩家选项",
      "text": "把彩虹豆豆跳跳糖递给爱弥斯"
    },
    {
      "role": "爱弥斯",
      "text": "好鲜艳！这是围棋部给勤奋思考死活题的人准备的限定奖励吗？"
    },
    {
      "role": "玩家选项",
      "text": "差不多吧，要尝一颗吗？"
    },
    {
      "role": "爱弥斯",
      "text": "虽然我现在已经不需要吃东西了，不过作为跟风尝鲜派，流行新品还是要积极体验一下的——"
    },
    {
      "role": "旁白",
      "text": "爱弥斯将糖果放进口中。细碎的噼啪声刚刚响起，她的电子轮廓便猛地闪烁了一下。红、橙、黄、绿、青、蓝、紫七道像素残影依次从她身后弹开，又摇摇晃晃地重叠在一起。"
    },
    {
      "role": "爱弥斯",
      "text": "咦？我的频率好像有点奇怪..."
    },
    {
      "role": "玩家选项",
      "text": "原来爱弥斯吃了糖果会变成这样啊。"
    },
    {
      "role": "爱弥斯",
      "text": "会变成这样？原来这不是奖励，是你的整蛊道具啊！”"
    },
    {
      "role": "旁白",
      "text": "爱弥斯眯起眼睛看向你，手中的黑棋却不小心落在了棋盘上。"
    },
    {
      "role": "旁白",
      "text": "棋子接触交叉点的瞬间，一圈七彩像素光纹“啪”地绽开，沿着棋盘线飞快扩散，然后消失。"
    },
    {
      "role": "爱弥斯",
      "text": "“哇——等等！刚才那是什么？再来一次！”"
    },
    {
      "role": "角色区域留空",
      "text": "爱弥斯又夹起一枚白棋，兴致勃勃地拍上棋盘。新的彩虹光纹随之炸开。"
    },
    {
      "role": "玩家选项",
      "text": "这么酷炫的吗？"
    },
    {
      "role": "爱弥斯",
      "text": "原来如此……糖果影响了我的频率，棋子在接触我的时候也会受到影响。"
    },
    {
      "role": "爱弥斯",
      "text": "好！这个状态就叫——彩虹落子模式！"
    }
  ],
  "爱弥斯-失败": [
    {
      "role": "旁白",
      "text": "爱弥斯趴在棋盘前，捧着脸拿着手机浏览着校内论坛上最新的美食推荐。"
    },
    {
      "role": "玩家选项",
      "text": "把彩虹豆豆跳跳糖递给爱弥斯"
    },
    {
      "role": "爱弥斯",
      "text": "新品糖果？颜色倒是很符合最近的流行趋势……"
    },
    {
      "role": "玩家选项",
      "text": "只是普通的糖，尝一颗吧。"
    },
    {
      "role": "爱弥斯",
      "text": "嗯——糖也许很普通，但刚刚你说“普通”的时候，脸上诡异的笑容像是触发了隐藏成就。"
    },
    {
      "role": "玩家选项",
      "text": "啊？有这么明显的吗？"
    },
    {
      "role": "爱弥斯",
      "text": "很明显噢。我可是电子幽灵，观察表情可算是基本功之一~"
    },
    {
      "role": "爱弥斯",
      "text": "想让我当新品测试玩家也不是不行，不过测试规则得公平一点。"
    },
    {
      "role": "玩家选项",
      "text": "什么测试规则？"
    },
    {
      "role": "爱弥斯",
      "text": "你先吃，我负责录像、剪辑，再把全过程上传到学院论坛。这样我们谁也不吃亏，对吧？"
    },
    {
      "role": "旁白",
      "text": "你默默收回了糖果。爱弥斯托着脸，满脸遗憾地看着你。"
    },
    {
      "role": "爱弥斯",
      "text": "诶，别走呀？标题我都想好了——《{username}的整蛊糖果首秀》！真的不考虑一下吗？"
    }
  ],
  "琳奈-成功": [
    {
      "role": "旁白",
      "text": "傍晚的活动部，琳奈盘腿坐在地板上，正在给几个旧棋罐做重新喷涂。"
    },
    {
      "role": "琳奈",
      "text": "黑色、白色、黑色、白色……围棋本身明明很有趣，装棋子的东西也可以再大胆一点嘛。"
    },
    {
      "role": "玩家选项",
      "text": "把彩虹豆豆跳跳糖递给琳奈"
    },
    {
      "role": "琳奈",
      "text": "哇，这个配色不错！我第一次见到这么炫丽的糖果。"
    },
    {
      "role": "玩家选项",
      "text": "要尝一颗吗？"
    },
    {
      "role": "琳奈",
      "text": "当然！有点好奇这糖果会是什么味道..."
    },
    {
      "role": "旁白",
      "text": "琳奈将糖果抛进口中。细碎的噼啪声响起，她饶有兴致地嚼了几下。"
    },
    {
      "role": "琳奈",
      "text": "嗯，味道还挺难吃的……"
    },
    {
      "role": "旁白",
      "text": "琳奈脸上的笑容突然僵住了。"
    },
    {
      "role": "玩家选项",
      "text": "这么难吃吗？"
    },
    {
      "role": "琳奈",
      "text": "不是！我刚才明明想说的是难吃！"
    },
    {
      "role": "琳奈",
      "text": "这颗糖很无聊——不对，是无聊！非常无聊！"
    },
    {
      "role": "旁白",
      "text": "琳奈突然捂住了嘴，朝你挤眉弄眼。"
    },
    {
      "role": "玩家选项",
      "text": "难道......你说的话全都变成反话了？！"
    },
    {
      "role": "琳奈",
      "text": "“呜哇，看来是这样。真方便……”"
    },
    {
      "role": "旁白",
      "text": "琳奈耸了耸肩。"
    },
    {
      "role": "琳奈",
      "text": "……我还是等时效过去再说话吧。"
    }
  ],
  "琳奈-失败": [
    {
      "role": "旁白",
      "text": "琳奈坐在围棋部的窗边，正对着一个旧棋罐试验新的喷涂配色。"
    },
    {
      "role": "玩家选项",
      "text": "把彩虹豆豆跳跳糖递给琳奈"
    },
    {
      "role": "琳奈",
      "text": "这个颜色挺有意思。是最近流行的新品吗？"
    },
    {
      "role": "玩家选项",
      "text": "只是普通的糖，尝一颗吧。"
    },
    {
      "role": "琳奈",
      "text": "普通？"
    },
    {
      "role": "琳奈",
      "text": "那不是对食物最无聊的评价吗？"
    },
    {
      "role": "旁白",
      "text": "琳奈接过糖果翻看了一圈，包装上什么信息也没有。琳奈皱了皱眉头。"
