+ .utility-entry,
+ .segmented button,
+ .toggle):not(.home-image-entry):not(:disabled):hover,
+ :is(.primary-action,
+ .secondary-action,
+ .match-button,
+ .action-bar button,
+ .chat-box button,
+ .watch-pad button,
+ .danger-action,
+ .icon-button,
